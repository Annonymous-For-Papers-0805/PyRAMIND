# Azure OpenAI credentials (or any OpenAI-compatible endpoint).
# Copy this file to `.env` and fill in your own values.
#
# The codebase queries gpt-4.1 for entity extraction + answer generation
# and text-embedding-3-large for embeddings. Any equivalent deployment works
# (the deployment names are read from the variables below).

AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-endpoint>/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Embedding backend selection (mirrors PyramindConfig.embedding_backend).
# EMBEDDING_BACKEND="bge"    # paper default; requires sentence-transformers
# EMBEDDING_BACKEND="azure"  # cost/latency-friendly alternative; uses AZURE_OPENAI_EMBED_DEPLOYMENT
